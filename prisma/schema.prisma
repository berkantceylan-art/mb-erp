// Prisma Schema for MB Diş Protez Enterprise ERP
// Aşama 1: i18n, RBAC & Çok Paydaşlı Veritabanı Mimarisi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUM TANIMLARI
// -------------------------------------------------------------

enum SupportedLocale {
  tr // Türkçe
  en // English
  fr // Français
  de // Deutsch
}

enum SupportedCurrency {
  TRY // Türk Lirası
  EUR // Euro
  USD // ABD Doları
}

enum RoleCode {
  SUPER_ADMIN      // Şirket Sahibi / Genel Müdür
  STAFF_PERSONEL   // Şirket İçi Personeller (Muhasebe, İK, Depo, Üretim)
  DOCTOR_LOCAL     // Yurt İçi Diş Hekimi
  DOCTOR_FOREIGN   // Yurt Dışı Diş Hekimi
  CLINIC_LOCAL     // Yurt İçi Klinik
  CLINIC_FOREIGN   // Yurt Dışı Klinik
  AGENT_LOCAL      // Yurt İçi Aracı / Satış Temsilcisi
  AGENT_FOREIGN    // Yurt Dışı Aracı / İhracat Temsilcisi
}

enum StaffDepartment {
  ACCOUNTING  // Muhasebe & Finans
  HR          // İnsan Kaynakları & PDKS
  WAREHOUSE   // Depo & Stok Yönetimi
  PRODUCTION  // Protez Üretim & Laboratuvar
  MANAGEMENT  // Yönetim
  LOGISTICS   // Lojistik & Kargo
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  DEACTIVATED
}

// -------------------------------------------------------------
// KULLANICI & KİMLİK DOĞRULAMA (AUTH & USER PROFILE)
// -------------------------------------------------------------

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  phone             String?           @unique
  firstName         String
  lastName          String
  avatarUrl         String?
  status            UserStatus        @default(ACTIVE)
  preferredLocale   SupportedLocale   @default(tr)
  preferredCurrency SupportedCurrency @default(TRY)
  
  // Güvenlik & Doğrulama
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  twoFactorEnabled  Boolean           @default(false)
  twoFactorSecret   String?

  // İlişkiler
  userRoles         UserRole[]
  doctorProfile     DoctorProfile?
  clinicProfile     ClinicProfile?
  agentProfile      AgentProfile?
  staffProfile      StaffProfile?
  auditLogs         AuditLog[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@map("users")
}

// -------------------------------------------------------------
// ROL TABANLI YETKİLENDİRME (RBAC)
// -------------------------------------------------------------

model Role {
  id          String       @id @default(uuid())
  code        RoleCode     @unique
  name        String       // Örn: "Super Admin", "Yurt Dışı Doktor"
  description String?
  isSystem    Boolean      @default(true)
  
  permissions RolePermission[]
  userRoles   UserRole[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // Örn: "order.create", "invoice.view", "stock.manage"
  module      String           // Örn: "ORDERS", "FINANCE", "INVENTORY", "HR", "PRODUCTION"
  description String?
  
  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

// -------------------------------------------------------------
// PAYDAŞ PROFİLLERİ (STAKEHOLDERS)
// -------------------------------------------------------------

// 1. Doktor Profili (Yurt İçi / Yurt Dışı)
model DoctorProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isForeign         Boolean           @default(false) // Foreign vs Local
  diplomaNo         String?
  specialization    String?           // Örn: Protetik Diş Tedavisi, Ortodonti
  taxNumber         String?
  taxOffice         String?
  
  // Bağlı olduğu Klinik & Aracı (Varsa)
  clinicId          String?
  clinic            ClinicProfile?    @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  agentId           String?
  agent             AgentProfile?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Adres ve Lokasyon
  countryCode       String            @default("TR")
  city              String?
  addressLine       String?
  postalCode        String?

  defaultCurrency   SupportedCurrency @default(TRY)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([isForeign])
  @@index([clinicId])
  @@index([agentId])
  @@map("doctor_profiles")
}

// 2. Klinik Profili (Yurt İçi / Yurt Dışı)
model ClinicProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isForeign         Boolean           @default(false)
  clinicName        String            // Klinik Ticari Ünvanı
  tradeRegistryNo   String?
  taxNumber         String?
  taxOffice         String?
  
  countryCode       String            @default("TR")
  city              String?
  addressLine       String?
  postalCode        String?
  
  contactPerson     String?
  contactPhone      String?
  defaultCurrency   SupportedCurrency @default(TRY)

  // Bağlı Aracı
  agentId           String?
  agent             AgentProfile?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Kliniğe bağlı doktorlar
  doctors           DoctorProfile[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([isForeign])
  @@index([agentId])
  @@map("clinic_profiles")
}

// 3. Aracı / Satış Temsilcisi Profili (Yurt İçi / Yurt Dışı)
model AgentProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isForeign         Boolean           @default(false)
  companyName       String?           // Varsa ajans/şirket adı
  taxNumber         String?
  commissionRate    Decimal           @default(0.0) @db.Decimal(5, 2) // Komisyon yüzdesi örn: %10.00
  assignedRegion    String?           // Örn: "Avrupa / Fransa", "Marmara Bölgesi"
  
  countryCode       String            @default("TR")
  city              String?
  addressLine       String?
  defaultCurrency   SupportedCurrency @default(TRY)

  // Aracının getirdiği hekimler ve klinikler
  doctors           DoctorProfile[]
  clinics           ClinicProfile[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([isForeign])
  @@map("agent_profiles")
}

// 4. MB Diş Protez Şirket İçi Personel Profili (Staff)
model StaffProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  department        StaffDepartment
  jobTitle          String            // Örn: "Kıdemli Seramist", "Muhasebe Uzmanı", "PDKS Sorumlusu"
  employeeId        String            @unique // Şirket içi sicil no
  nationalId        String?           // TC Kimlik / Pasaport No
  
  hireDate          DateTime
  terminationDate   DateTime?
  emergencyContact  String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([department])
  @@index([employeeId])
  @@map("staff_profiles")
}

// -------------------------------------------------------------
// ÇOKLU DİL (i18n) & DİNAMİK ÇEVİRİ MİMARİSİ
// -------------------------------------------------------------

model I18nNamespace {
  id          String        @id @default(uuid())
  code        String        @unique // Örn: "common", "auth", "products", "invoices", "notifications"
  description String?
  
  keys        I18nKey[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("i18n_namespaces")
}

model I18nKey {
  id            String            @id @default(uuid())
  namespaceId   String
  key           String            // Örn: "welcome_message", "status_in_production"
  defaultText   String            // Geliştirici varsayılan metni
  
  namespace     I18nNamespace     @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  translations  I18nTranslation[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([namespaceId, key])
  @@index([key])
  @@map("i18n_keys")
}

model I18nTranslation {
  id          String          @id @default(uuid())
  keyId       String
  locale      SupportedLocale
  content     String          @db.Text
  
  key         I18nKey         @relation(fields: [keyId], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([keyId, locale])
  @@index([locale])
  @@map("i18n_translations")
}

// -------------------------------------------------------------
// DÖVİZ & KUR YÖNETİMİ (CURRENCY & RATES)
// -------------------------------------------------------------

model ExchangeRate {
  id            String            @id @default(uuid())
  baseCurrency  SupportedCurrency @default(TRY)
  targetCurrency SupportedCurrency
  rate          Decimal           @db.Decimal(12, 6) // Örn: 1 USD = 34.500000 TRY
  source        String            @default("TCMB")   // TCMB, ECB, Manuel
  effectiveDate DateTime          @default(now())

  createdAt     DateTime          @default(now())

  @@index([baseCurrency, targetCurrency, effectiveDate])
  @@map("exchange_rates")
}

// -------------------------------------------------------------
// SİSTEM DENETİM İZİ (AUDIT LOGS)
// -------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   // Örn: "LOGIN", "ROLE_ASSIGN", "UPDATE_LOCALE", "ORDER_STATUS_CHANGE"
  entityType  String   // Örn: "User", "DoctorProfile", "Invoice"
  entityId    String?
  details     Json?    // Değişiklik öncesi/sonrası veriler
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Prisma Schema for MB Diş Protez & CAD/CAM ERP
// Enterprise Level Super Admin, RBAC, Multi-Currency & Audit Logging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUM TANIMLARI
// -------------------------------------------------------------

enum Role {
  SUPER_ADMIN      // Şirket Sahibi / Genel Müdür
  STAFF_PERSONEL   // Şirket İçi Personeller (Muhasebe, İK, Depo, Üretim)
  DOCTOR_LOCAL     // Yurt İçi Diş Hekimi
  DOCTOR_FOREIGN   // Yurt Dışı Diş Hekimi
  CLINIC_LOCAL     // Yurt İçi Klinik
  CLINIC_FOREIGN   // Yurt Dışı Klinik
  AGENT_LOCAL      // Yurt İçi Aracı / Bölge Temsilcisi
  AGENT_FOREIGN    // Yurt Dışı Aracı / İhracat Temsilcisi
}

enum StaffDepartment {
  ACCOUNTING  // Muhasebe & Finans
  HR          // İnsan Kaynakları & PDKS
  WAREHOUSE   // Depo & Stok Yönetimi
  PRODUCTION  // Protez Üretim & Laboratuvar
}

enum SupportedLocale {
  tr // Türkçe
  en // English
  fr // Français
  de // Deutsch
}

enum SupportedCurrency {
  TRY // Türk Lirası
  EUR // Euro
  USD // ABD Doları
}

// -------------------------------------------------------------
// USER (KULLANICI & AUTH) MODELİ
// -------------------------------------------------------------

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role              @default(STAFF_PERSONEL)
  department        StaffDepartment?  // Sadece STAFF_PERSONEL ise geçerli
  locale            SupportedLocale   @default(tr)
  currency          SupportedCurrency @default(TRY)
  isActive          Boolean           @default(true)
  twoFactorEnabled  Boolean           @default(false)
  twoFactorSecret   String?

  auditLogs         AuditLog[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// -------------------------------------------------------------
// AUDIT LOG (DENETİM İZİ & GÜVENLİK GÜNLÜĞÜ) MODELİ
// -------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // Örn: "ADMIN_LOGIN_SUCCESS", "ADMIN_LOGIN_FAILED", "USER_CREATED"
  ipAddress   String?
  details     Json?    // Ekstra detaylar (User-Agent, hata mesajı, değişen veri)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
